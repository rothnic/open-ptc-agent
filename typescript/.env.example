# TypeScript PTC Agent Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API Keys (at least one LLM provider required)
# =============================================================================

# Anthropic (Claude models)
ANTHROPIC_API_KEY=your-key

# OpenAI (GPT models)
# OPENAI_API_KEY=your-key

# Google (Gemini models)
# GOOGLE_API_KEY=your-key

# Daytona Sandbox (required for code execution)
DAYTONA_API_KEY=your-key

# =============================================================================
# Model Configuration
# =============================================================================

# Default model used when no model is specified
# PTC_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# Model tiers - use these for different capability levels
# PTC_POWERFUL_MODEL=claude-sonnet-4-5-20250929    # For complex reasoning tasks
# PTC_STANDARD_MODEL=claude-sonnet-4-5-20250929    # For general use
# PTC_LIGHTWEIGHT_MODEL=claude-sonnet-4-5-20250929 # For simple, fast tasks

# =============================================================================
# Subagent Model Overrides
# =============================================================================

# Override model for specific subagent types (defaults to PTC_STANDARD_MODEL)
# PTC_RESEARCH_MODEL=claude-sonnet-4-5-20250929
# PTC_GENERAL_PURPOSE_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# Agent Configuration
# =============================================================================

# Maximum recursion limit for agent (default: 50)
# PTC_MAX_RECURSION_LIMIT=50

# Enable vision/image capabilities (default: true)
# PTC_ENABLE_VISION=true

# Enable custom filesystem tools (default: true)
# PTC_ENABLE_CUSTOM_FS_TOOLS=true

# Comma-separated list of enabled subagents (default: general-purpose,research)
# PTC_ENABLED_SUBAGENTS=general-purpose,research

# =============================================================================
# Logging
# =============================================================================

# Log level (default: info)
# PTC_LOG_LEVEL=info
